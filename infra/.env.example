# 이 파일을 복사해서 .env로 만들고 값을 채워주세요
# cp .env.example .env
# .env는 git에 올라가지 않습니다 (.gitignore에 등록됨)

# GitHub Container Registry 사용자명
GHCR_USER=your-github-username

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# JWT (32자 이상 임의 문자열)
JWT_SECRET=your-very-long-secret-key-that-is-at-least-32-bytes-long

# 카카오 개발자 콘솔에서 발급
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
