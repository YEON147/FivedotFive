# 이 파일을 복사해서 .env.local로 만들고 값을 채워주세요
# cp .env.local.example .env.local
# .env.local은 git에 올라가지 않습니다 (.gitignore에 등록됨)

# PostgreSQL (docker-compose.local.yml 기준 기본값 - 변경 불필요)
DB_URL=jdbc:postgresql://localhost:5433/oh_jjeom_oh
DB_USERNAME=postgres
DB_PASSWORD=1234

# Redis (변경 불필요)
REDIS_HOST=localhost
REDIS_PORT=6379

# ⚠️ 반드시 채워야 함 - 32자 이상 임의 문자열
JWT_SECRET=

# ⚠️ 반드시 채워야 함 - 카카오 개발자 콘솔에서 발급
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ⚠️ 반드시 채워야 함 - 관리자 계정 초기 비밀번호 (서버 시작 시 자동 생성)
ADMIN_PASSWORD=
